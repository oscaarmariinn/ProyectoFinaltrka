{% extends 'base.html.twig' %}

{% block title %}Registro{% endblock %}

{% block body %}
    <div style="min-height:100vh; display:flex; align-items:center; justify-content:center;">
        <div style="width:100%; max-width:480px; background:#1e1e2f; padding:40px; border-radius:16px; box-shadow:0 10px 30px rgba(0,0,0,.4);">

            <h1 style="color:white; text-align:center; margin-bottom:30px;">Crear cuenta</h1>

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm) }}

            <div style="margin-bottom:20px;">
                {{ form_label(registrationForm.name, 'Nombre', {'label_attr': {'style': 'color:white; font-weight:500; margin-bottom:8px; display:block;'}}) }}
                {{ form_widget(registrationForm.name, {'attr': {'class': 'input'}}) }}
            </div>

            <div style="margin-bottom:20px;">
                {{ form_label(registrationForm.surname, 'Apellidos', {'label_attr': {'style': 'color:white; font-weight:500; margin-bottom:8px; display:block;'}}) }}
                {{ form_widget(registrationForm.surname, {'attr': {'class': 'input'}}) }}
            </div>

            <div style="margin-bottom:20px;">
                {{ form_label(registrationForm.email, 'Email', {'label_attr': {'style': 'color:white; font-weight:500; margin-bottom:8px; display:block;'}}) }}
                {{ form_widget(registrationForm.email, {'attr': {'class': 'input'}}) }}
            </div>

            <div style="margin-bottom:25px;">
                {{ form_label(registrationForm.plainPassword, 'Contraseña', {'label_attr': {'style': 'color:white; font-weight:500; margin-bottom:8px; display:block;'}}) }}
                {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'input'}}) }}
            </div>

            <button type="submit" style="width:100%; padding:14px; background:#6c5ce7; border:none; border-radius:10px; color:white; font-weight:600; font-size:16px; cursor:pointer;">
                Registrarse
            </button>

            {{ form_end(registrationForm) }}

        </div>
    </div>

    <style>
        .input {
            width:100%;
            padding:12px 14px;
            border-radius:10px;
            border:1px solid #3a3a55;
            background:#2a2a40;
            color:white;
            font-size:14px;
        }
        .input:focus {
            outline:none;
            border-color:#6c5ce7;
            box-shadow:0 0 0 2px rgba(108,92,231,.25);
        }
    </style>
{% endblock %}
